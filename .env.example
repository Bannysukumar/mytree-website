# Copy to .env and fill in. Never commit real secrets.

# --- Frontend (Vite). Only public config belongs here. ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_WALLETCONNECT_PROJECT_ID=
VITE_SITE_URL=https://uwgea32.web.app
VITE_FUNCTIONS_REGION=us-central1

# --- Hardhat deploy ---
RPC_URL=https://bsc-dataseed.binance.org
BSC_RPC_URL=https://bsc-dataseed.binance.org
PRIVATE_KEY=
BSCSCAN_API_KEY=
TREASURY_ADDRESS=
# BSC USDT (BEP20, 18 decimals). Buys accept this token only.
USDT_ADDRESS=0x55d398326f99059fF775485246999027B3197955
# Whole tokens moved from treasury into the presale contract
SALE_ALLOCATION=200000000
REWARDS_ALLOCATION=80000000
# Human USDT amounts. 0.012 means 0.012 USDT per 1 $MYTREE.
PRICE_USDT_PER_TOKEN=0.012
MIN_USDT=10
MAX_USDT=5000

# --- Cloud Functions (set with `firebase functions:secrets:set`, not in the client) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PRESALE_ADDRESS=
SENDGRID_API_KEY=
FROM_EMAIL=
ADMIN_NOTIFY_EMAIL=
PURCHASE_WEBHOOK_SECRET=
