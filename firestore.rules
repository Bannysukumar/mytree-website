rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/adminEmails/$(request.auth.token.email))
      );
    }

    function validTimestamp() {
      return request.resource.data.createdAt == request.time;
    }

    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /tracks/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /poga/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /tokenomics/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /team/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /posts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /testimonials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /tiers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /simulatorTasks/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Ledger-style records are written only by Cloud Functions (admin SDK).
    match /purchases/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /donations/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /referralLedger/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /users/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /codes/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /stats/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /rateLimits/{id} {
      allow read, write: if false;
    }

    match /auditLog/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.actorEmail == request.auth.token.email
        && validTimestamp();
      allow update, delete: if false;
    }
    match /adminEmails/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /walletLists/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /contactSubmissions/{id} {
      allow create: if validTimestamp()
        && request.resource.data.keys().hasOnly(["name", "email", "message", "createdAt"])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 80
        && request.resource.data.email is string
        && request.resource.data.email.matches(".*@.*\\..*")
        && request.resource.data.email.size() < 120
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() < 2000;
      allow read, update, delete: if isAdmin();
    }

    match /newsletter/{id} {
      allow create: if validTimestamp()
        && request.resource.data.keys().hasOnly(["email", "createdAt"])
        && request.resource.data.email is string
        && request.resource.data.email.matches(".*@.*\\..*")
        && request.resource.data.email.size() < 120;
      allow read, update, delete: if isAdmin();
    }

    match /ownership/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /leaderboardWinners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /promoRedemptions/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
